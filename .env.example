# Supabase (lokaal: waarden uit `npx supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (alleen server-side, voor foto's van producten en bonnetjes)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Web push (genereer met: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vincentpost@gmail.com

# Beveiliging van de cron-routes (nachtelijke opruiming, aanbiedingen, herinnering)
CRON_SECRET=
